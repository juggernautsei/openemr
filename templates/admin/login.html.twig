{% extends "admin/base.html.twig" %}

{% block title %}{{ 'Admin Login'|xlt }} — {{ 'Multi-Site Administration'|xlt }}{% endblock %}

{% block css %}
{{ parent() }}
<style type="text/css">
    .login-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #0b3d91 0%, #1a9b8e 100%);
    }
    .login-card {
        background-color: #fff;
        border-radius: 1rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        padding: 2rem;
        max-width: 400px;
        width: 100%;
    }
    .login-header {
        text-align: center;
        margin-bottom: 2rem;
    }
    .login-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #0b3d91;
        margin-bottom: 0.5rem;
    }
    .password-wrapper { position: relative; }
    .password-toggle {
        cursor: pointer;
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
    }
</style>
{% endblock %}

{% block content %}
<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h1>{{ 'TAREVO'|xlt }}</h1>
            <p class="text-muted mb-0">{{ 'Multi-Site Administration'|xlt }}</p>
        </div>

        {% if loginFail %}
        <div class="alert alert-danger" role="alert">
            <i class="fa fa-exclamation-triangle"></i> {{ errorMessage|text }}
        </div>
        {% endif %}

        <form method="POST" action="login.php" autocomplete="off">
            {{ csrfToken('admin_login', 'csrf_token_form') }}

            <div class="form-group">
                <label for="authUser">{{ 'Username'|xlt }}</label>
                <input type="text" class="form-control" id="authUser" name="authUser"
                       placeholder="{{ 'Enter username'|xla }}" required autofocus>
            </div>

            <div class="form-group">
                <label for="clearPass">{{ 'Password'|xlt }}</label>
                <div class="password-wrapper">
                    <input type="password" class="form-control" id="clearPass" name="clearPass"
                           placeholder="{{ 'Enter password'|xla }}" required>
                    <i class="fa fa-eye password-toggle" id="password-icon" aria-hidden="true"></i>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" name="login_submit" value="1">
                <i class="fa fa-sign-in-alt"></i> {{ 'Login'|xlt }}
            </button>
        </form>

        <div class="text-center mt-3">
            <small class="text-muted">{{ 'OpenEMR Version'|xlt }} {{ version|text }}</small>
        </div>
    </div>
</div>
{% endblock %}

{% block post_body %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const passInput = document.getElementById('clearPass');
    const toggle = document.getElementById('password-icon');
    if (toggle && passInput) {
        toggle.addEventListener('click', function () {
            const isPassword = passInput.getAttribute('type') === 'password';
            passInput.setAttribute('type', isPassword ? 'text' : 'password');
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });
    }
});
</script>
{% endblock %}
