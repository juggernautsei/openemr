{% extends "admin/base.html.twig" %}

{% block title %}{{ 'Multi-Site Administration'|xlt }}{% endblock %}

{% block css %}
{{ parent() }}
<style type="text/css">
    .site-table-container {
        background-color: #fff;
        border-radius: 0.5rem;
        padding: 1.25rem 1.5rem 1.5rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    .page-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }
    .page-toolbar h1 {
        font-size: 1.35rem;
        margin: 0;
        font-weight: 600;
        color: #0b3d91;
    }
</style>
{% endblock %}

{% block content %}
<div class="page-toolbar">
    <h1>
        <i class="fa fa-th-list" aria-hidden="true"></i>
        {{ 'Configured Sites'|xlt }}
    </h1>
    <div class="d-flex align-items-center flex-wrap">
        {% if cache_age is defined %}
        <small class="text-muted mr-3">
            <i class="fa fa-clock" aria-hidden="true"></i>
            {{ 'Last updated'|xlt }}: {{ cache_age|text }}
            {% if using_cache|default(false) %}
                <span class="badge badge-secondary ml-1">{{ 'cached'|xlt }}</span>
            {% else %}
                <span class="badge badge-info ml-1">{{ 'live'|xlt }}</span>
            {% endif %}
        </small>
        {% endif %}
        <form method="post" action="index.php" class="d-inline mb-0">
            {{ csrfToken('admin_dashboard', 'csrf_token_form') }}
            <input type="hidden" name="admin_action" value="refresh">
            <button type="submit" class="btn btn-outline-secondary btn-sm" title="{{ 'Refresh site list'|xlt }}">
                <i class="fa fa-sync-alt"></i> {{ 'Refresh'|xlt }}
            </button>
        </form>
    </div>
</div>

<div class="site-table-container">
    <div class="table-responsive">
        <table class="table table-striped table-hover text-center mb-0">
            <thead class="thead-light">
                <tr>
                    <th>{{ 'Site ID'|xlt }}</th>
                    <th>{{ 'DB Name'|xlt }}</th>
                    <th>{{ 'Site Name'|xlt }}</th>
                    <th>{{ 'Version'|xlt }}</th>
                    <th>{{ 'Is Current'|xlt }}</th>
                    <th>{{ 'Log In'|xlt }}</th>
                    <th>{{ 'Patient Portal'|xlt }}</th>
                </tr>
            </thead>
            <tbody>
                {% for site in sites %}
                    <tr>
                        <td><strong>{{ site.site_id|text }}</strong></td>
                        <td>{{ site.db_name|text }}</td>

                        {% if site.needs_setup %}
                            <td colspan="3">
                                <a href="{{ webroot }}/setup.php?site={{ site.site_id|url_encode }}" class="btn btn-warning btn-sm">
                                    <i class="fa fa-cog"></i> {{ 'Needs setup, click here to run it'|xlt }}
                                </a>
                            </td>
                        {% elseif site.error %}
                            <td colspan="3" class="text-danger">
                                <i class="fa fa-exclamation-triangle"></i> {{ site.error|text }}
                            </td>
                        {% else %}
                            <td>{{ site.site_name|text }}</td>
                            <td><span class="badge badge-info">{{ site.version|text }}</span></td>

                            {% if site.requires_upgrade %}
                                {% if site.upgrade_type == 'database' %}
                                    <td>
                                        <a href="{{ webroot }}/sql_upgrade.php?site={{ site.site_id|url_encode }}" class="btn btn-warning btn-sm">
                                            <i class="fa fa-arrow-up"></i> {{ 'Upgrade Database'|xlt }}
                                        </a>
                                    </td>
                                {% elseif site.upgrade_type == 'acl' %}
                                    <td>
                                        <a href="{{ webroot }}/acl_upgrade.php?site={{ site.site_id|url_encode }}" class="btn btn-warning btn-sm">
                                            <i class="fa fa-shield-alt"></i> {{ 'Upgrade Access Controls'|xlt }}
                                        </a>
                                    </td>
                                {% elseif site.upgrade_type == 'patch' %}
                                    <td>
                                        <a href="{{ webroot }}/sql_patch.php?site={{ site.site_id|url_encode }}" class="btn btn-warning btn-sm">
                                            <i class="fa fa-wrench"></i> {{ 'Patch Database'|xlt }}
                                        </a>
                                    </td>
                                {% else %}
                                    <td class="text-warning">{{ 'Upgrade Required'|xlt }}</td>
                                {% endif %}
                            {% else %}
                                <td>
                                    <i class="fa fa-check-circle fa-lg text-success" aria-hidden="true"></i>
                                </td>
                            {% endif %}

                            {% if site.is_current %}
                                <td>
                                    <a href="{{ webroot }}/interface/login/login.php?site={{ site.site_id|url_encode }}" class="btn btn-primary btn-sm" title="{{ 'Login to site'|xlt }} {{ site.site_id|text }}">
                                        <i class="fa fa-sign-in-alt"></i> {{ 'Login'|xlt }}
                                    </a>
                                </td>
                                <td>
                                    <a href="{{ webroot }}/portal/?site={{ site.site_id|url_encode }}" class="btn btn-success btn-sm" title="{{ 'Patient Portal for'|xlt }} {{ site.site_id|text }}">
                                        <i class="fa fa-hospital-user"></i> {{ 'Portal'|xlt }}
                                    </a>
                                </td>
                            {% else %}
                                <td><i class="fa fa-ban fa-lg text-secondary" aria-hidden="true"></i></td>
                                <td><i class="fa fa-ban fa-lg text-secondary" aria-hidden="true"></i></td>
                            {% endif %}
                        {% endif %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-muted">{{ 'No sites found under sites/'|xlt }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if show_add_site_button %}
        <div class="mt-3 pt-3 border-top" id="add-site">
            <h2 class="h5 mb-2">{{ 'Add New Site'|xlt }}</h2>
            <p class="text-muted small mb-2">{{ 'Starts the OpenEMR multi-site setup wizard for a new clinic site.'|xlt }}</p>
            <form method="post" action="{{ webroot }}/setup.php">
                {{ csrfToken('admin_add_site', 'csrf_token_form') }}
                <button type="submit" class="btn btn-primary" name="form_submit" value="Add New Site">
                    <i class="fa fa-plus-circle"></i> {{ 'Add New Site'|xlt }}
                </button>
            </form>
        </div>
    {% else %}
        <div class="mt-3 pt-3 border-top" id="add-site">
            <h2 class="h5 mb-2">{{ 'Add New Site'|xlt }}</h2>
            <p class="text-muted small mb-0">
                {{ 'Multi-site setup is off. An operator must set OPENEMR_ALLOW_MULTISITE_SETUP=1 in the server environment (not Admin → Config), then refresh this page.'|xlt }}
            </p>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block post_body %}
{{ parent() }}
<script>
window.addEventListener('pageshow', function (event) {
    if (event.persisted) {
        window.location.reload();
    }
});
</script>
{% endblock %}
