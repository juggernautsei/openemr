<script>

    /**
     * Default Font Awesome icons for top-level main menu labels (vertical shell).
     * Nested items keep JSON icons (often fa-caret-right) or none.
     */
    var mainMenuTopLevelIcons = {
        'Calendar': 'fa-calendar-alt',
        'Finder': 'fa-search',
        'Flow': 'fa-stream',
        'Recalls': 'fa-phone-alt',
        'Messages': 'fa-envelope',
        'Patient': 'fa-user',
        'Fees': 'fa-file-invoice-dollar',
        'Modules': 'fa-puzzle-piece',
        'Procedures': 'fa-notes-medical',
        'Admin': 'fa-cog',
        'Reports': 'fa-chart-bar',
        'Miscellaneous': 'fa-ellipsis-h',
        'Popups': 'fa-window-restore',
        'About': 'fa-info-circle'
    };

    function resolveMenuIcon(object, depth)
    {
        if (object.icon && object.icon !== 'fa-caret-right') {
            return object.icon;
        }
        if (depth === 0 && object.label && mainMenuTopLevelIcons[object.label]) {
            return mainMenuTopLevelIcons[object.label];
        }
        // Nested expandable section: use a chevron-style marker only when JSON asked for caret
        if (depth > 0 && object.icon === 'fa-caret-right') {
            return 'fa-angle-right';
        }
        if (object.icon) {
            return object.icon;
        }
        return '';
    }

    function menu_entry(object, depth)
    {
        var self=this;
        depth = typeof depth === 'number' ? depth : 0;
        self.label=ko.observable(object.label);

        self.header=false;
        if('url' in object )
        {
            self.url=ko.observable(object.url);
            self.header=false;
        }
        else
        {
            self.header=true;
        }
        if('target' in object)
        {
            self.target=object.target;
        }
        self.requirement=object.requirement;

        self.icon = resolveMenuIcon(object, depth);

        if('helperText' in object)
        {
            self.helperText=object.helperText;
        }
        self.helperText=object.helperText;

        if(object.requirement===0)
        {
            self.enabled=ko.observable(true);
        } else if(object.requirement===1)
        {
            self.enabled=ko.computed(function()
            {
                return app_view_model.application_data.patient()!==null;
            });
        } else if((object.requirement===2) || (object.requirement===3))
        {
            self.enabled=ko.computed(function()
            {
                return (app_view_model.application_data.patient()!==null
                    && app_view_model.application_data.patient().selectedEncounter()!=null);
            });

        }
        else if(object.requirement===4)
        {
            self.enabled=ko.computed(function()
            {
                return app_view_model.application_data.therapy_group()!==null;
            });
        }
        else if(object.requirement===5)
        {
            self.enabled=ko.computed(function()
            {
                return (app_view_model.application_data.therapy_group()!==null
                    && app_view_model.application_data.therapy_group().selectedEncounter()!=null);
            });
        }
        if(self.header)
        {
            self.children=ko.observableArray();
            for(var childIdx=0;childIdx<object.children.length;childIdx++)
            {
                var childObj=new menu_entry(object.children[childIdx], depth + 1);
                self.children.push(childObj);
            }
        }
        return this;
    }
    function process_menu_object(object,target)
    {
        var newEntry=new menu_entry(object, 0);
        target.push(newEntry);
    }
    var menu_objects={{ menu_restrictions|json_encode }};
    app_view_model.application_data.menu=ko.observableArray();
    for(var menuIdx=0;menuIdx<menu_objects.length;menuIdx++)
    {
        var curObj=menu_objects[menuIdx];
        process_menu_object(curObj,app_view_model.application_data.menu);
    }
</script>
