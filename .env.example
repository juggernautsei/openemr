# Possible options are prod or dev. No spaces, no quotes.
OPENEMR__ENVIRONMENT=
# Set to true to disable periodic background service execution (Ajax piggybacking).
# Session timeouts and notification badges remain active. Accepts true/1 or false/0.
OPENEMR__NO_BACKGROUND_TASKS=

# Multi-site setup (ops only — do not expose in Admin → Config)
# Enables setup.php for non-default site IDs and the admin "Add New Site" action.
# Apache: SetEnv OPENEMR_ALLOW_MULTISITE_SETUP 1
# PHP-FPM: env[OPENEMR_ALLOW_MULTISITE_SETUP] = 1
# Docker compose: OPENEMR_ALLOW_MULTISITE_SETUP: "1"
OPENEMR_ALLOW_MULTISITE_SETUP=0
# Higher risk: allow DB cloning during setup. Keep 0 unless actively cloning.
OPENEMR_ALLOW_CLONING_SETUP=0

